# QMD CUDA Environment Variables
# Add these to your ~/.bashrc or ~/.zshrc

# CUDA 13.2 home
export CUDA_HOME=/usr/local/cuda-13.2

# WSL2 NVIDIA driver libraries
export LD_LIBRARY_PATH=/usr/lib/wsl/lib:/usr/local/cuda-13.2/lib64:$LD_LIBRARY_PATH

# Optional: Skip binding check for faster startup
# export NODE_LLAMA_CPP_SKIP_BINDING_CHECK=1
